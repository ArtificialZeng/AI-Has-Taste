// Discovery-only exact Groebner computation in Singular 4.4.1.
// This tests a compact polarized-power-sum generating family; it is not by
// itself a proof that the family generates the full invariant ideal.
LIB "nctools.lib";

proc test_n3()
{
  ring R3 = 0,(x1,x2,x3,t1,t2,t3,z1,z2,z3),dp;
  def A3 = superCommutative(4,9); setring A3;
  ideal I3 =
    x1+x2+x3,
    x1^2+x2^2+x3^2,
    x1^3+x2^3+x3^3,
    t1+t2+t3,
    x1*t1+x2*t2+x3*t3,
    x1^2*t1+x2^2*t2+x3^2*t3,
    z1+z2+z3,
    x1*z1+x2*z2+x3*z3,
    x1^2*z1+x2^2*z2+x3^2*z3,
    t1*z1+t2*z2+t3*z3,
    x1*t1*z1+x2*t2*z2+x3*t3*z3,
    x1^2*t1*z1+x2^2*t2*z2+x3^2*t3*z3;
  ideal G3 = twostd(I3);
  print("n=3 std-size="+string(size(G3))+" vdim="+string(vdim(G3)));
}

proc test_n4()
{
  ring R4 = 0,(x1,x2,x3,x4,t1,t2,t3,t4,z1,z2,z3,z4),dp;
  def A4 = superCommutative(5,12); setring A4;
  ideal I4 =
    x1+x2+x3+x4,
    x1^2+x2^2+x3^2+x4^2,
    x1^3+x2^3+x3^3+x4^3,
    x1^4+x2^4+x3^4+x4^4,
    t1+t2+t3+t4,
    x1*t1+x2*t2+x3*t3+x4*t4,
    x1^2*t1+x2^2*t2+x3^2*t3+x4^2*t4,
    x1^3*t1+x2^3*t2+x3^3*t3+x4^3*t4,
    z1+z2+z3+z4,
    x1*z1+x2*z2+x3*z3+x4*z4,
    x1^2*z1+x2^2*z2+x3^2*z3+x4^2*z4,
    x1^3*z1+x2^3*z2+x3^3*z3+x4^3*z4,
    t1*z1+t2*z2+t3*z3+t4*z4,
    x1*t1*z1+x2*t2*z2+x3*t3*z3+x4*t4*z4,
    x1^2*t1*z1+x2^2*t2*z2+x3^2*t3*z3+x4^2*t4*z4,
    x1^3*t1*z1+x2^3*t2*z2+x3^3*t3*z3+x4^3*t4*z4;
  ideal G4 = twostd(I4);
  print("n=4 std-size="+string(size(G4))+" vdim="+string(vdim(G4)));
}

proc test_n5()
{
  ring R5 = 0,(x1,x2,x3,x4,x5,t1,t2,t3,t4,t5,z1,z2,z3,z4,z5),dp;
  def A5 = superCommutative(6,15); setring A5;
  ideal I5 =
    x1+x2+x3+x4+x5,
    x1^2+x2^2+x3^2+x4^2+x5^2,
    x1^3+x2^3+x3^3+x4^3+x5^3,
    x1^4+x2^4+x3^4+x4^4+x5^4,
    x1^5+x2^5+x3^5+x4^5+x5^5,
    t1+t2+t3+t4+t5,
    x1*t1+x2*t2+x3*t3+x4*t4+x5*t5,
    x1^2*t1+x2^2*t2+x3^2*t3+x4^2*t4+x5^2*t5,
    x1^3*t1+x2^3*t2+x3^3*t3+x4^3*t4+x5^3*t5,
    x1^4*t1+x2^4*t2+x3^4*t3+x4^4*t4+x5^4*t5,
    z1+z2+z3+z4+z5,
    x1*z1+x2*z2+x3*z3+x4*z4+x5*z5,
    x1^2*z1+x2^2*z2+x3^2*z3+x4^2*z4+x5^2*z5,
    x1^3*z1+x2^3*z2+x3^3*z3+x4^3*z4+x5^3*z5,
    x1^4*z1+x2^4*z2+x3^4*z3+x4^4*z4+x5^4*z5,
    t1*z1+t2*z2+t3*z3+t4*z4+t5*z5,
    x1*t1*z1+x2*t2*z2+x3*t3*z3+x4*t4*z4+x5*t5*z5,
    x1^2*t1*z1+x2^2*t2*z2+x3^2*t3*z3+x4^2*t4*z4+x5^2*t5*z5,
    x1^3*t1*z1+x2^3*t2*z2+x3^3*t3*z3+x4^3*t4*z4+x5^3*t5*z5,
    x1^4*t1*z1+x2^4*t2*z2+x3^4*t3*z3+x4^4*t4*z4+x5^4*t5*z5;
  ideal G5 = twostd(I5);
  print("n=5 std-size="+string(size(G5))+" vdim="+string(vdim(G5)));
}

test_n3();
test_n4();
test_n5();
exit;
