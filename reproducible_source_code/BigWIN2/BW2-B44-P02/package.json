{
  "original_id": "win-00044-p02",
  "archive_id": "BW2-B44-P02",
  "title": "An Exact One-High-Boundary Obstruction for Cyclic 13-Layer K₇-Free Weighted Graphs",
  "batch_label": "44",
  "kind": "result-note",
  "original_status": "unresolved",
  "scope": "Consider a cyclic weighted graph with 13 nonempty layers, one to four vertices per layer, and edges only within layers or between consecutive layers. Assume the graph is K_7-free, every vertex has weighted open-neighborhood at least one, all vertex weights are nonnegative, and exactly one cyclic layer boundary has adjacent layer-cardinality sum at least seven. Then the total vertex weight is at least 4154/851, which is strictly greater than 39/8.",
  "gate_basis": "Current released terminal, manifest, PDF, TeX freeze, snapshot files, provenance and four audits agree.",
