{
  "schema": 1,
  "kind": "resolution-paper",
  "source_files": [
    "manuscript/main.tex",
    "manuscript/references.bib"
  ],
  "pdf": "manuscript/main.pdf",
  "build": {
    "working_directory": "manuscript",
    "command": "latexmk -pdf -interaction=nonstopmode -halt-on-error main.tex"
  }
}
