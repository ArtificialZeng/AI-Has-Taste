{
  "original_id": "win-00082-p11",
  "archive_id": "BW2-B82-P11",
  "title": "The Rank-One Mass-Three Radius for Five-Letter Additive Models Is 33",
  "batch_label": "82",
  "kind": "resolution-paper",
  "original_status": "proved",
  "scope": "For every increasing real five-letter alphabet T=(t_0<t_1<t_2<t_3<t_4), if the rational span of its balanced mass-at-most-three zero profile has rank one and the primitive balanced generator has mass three, then M_3(T) is at most 33. Moreover, the maximum is exactly 33 and, modulo changing the generator's sign, the only relation directions with M_3=33 are (1,-3,0,0,2) and its reversal (2,0,0,-3,1).",
  "gate_basis": "Current released terminal, manifest, PDF, TeX freeze, snapshot files, provenance and four audits agree.",
