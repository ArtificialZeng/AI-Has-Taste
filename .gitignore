# Older collections retain their local-only LaTeX policy; BigWIN2 is excepted below.
/latex_source_code/
# Reproduction bundles also contain copies of manuscript source files.
*.tex
*.bib
*.bbl
*.bst
*.sty
*.cls
*.ltx
*.dtx
*.ins
.latexmkrc
latexmkrc

# TeX build sidecars (PDFs are deliberately NOT ignored).
*.aux
*.blg
*.fls
*.fdb_latexmk
*.synctex.gz
*.toc
*.lof
*.lot
*.nav
*.snm
*.vrb

# Local staging, machine metadata, environments and bytecode.
/work/
.DS_Store
._*
__MACOSX/
__pycache__/
*.py[cod]
.venv/
venv/
.lake/
node_modules/
.env
.env.local

# Keep mathematical data and proof traces: no blanket *.json, *.txt,
# *.log, *.sha256, *.cnf, *.drat, *.lrat, *.done or *.pdf exclusions.

# BigWIN2 explicitly includes its paired manuscript sources.
!/reproducible_source_code/BigWIN2/**/*.tex
!/reproducible_source_code/BigWIN2/**/*.bib
!/reproducible_source_code/BigWIN2/**/*.bbl
!/reproducible_source_code/BigWIN2/**/*.bst
!/reproducible_source_code/BigWIN2/**/*.sty
!/reproducible_source_code/BigWIN2/**/*.cls
!/reproducible_source_code/BigWIN2/**/*.ltx
!/reproducible_source_code/BigWIN2/**/*.dtx
!/reproducible_source_code/BigWIN2/**/*.ins
!/reproducible_source_code/BigWIN2/**/.latexmkrc
!/reproducible_source_code/BigWIN2/**/latexmkrc

